# agent-expertise-api legacy local client configuration (ADR-0103).
#
# This is the committed LEGACY-LOCAL example. Copy it to `.env.local`
# (gitignored) and put local Development values there. For upstream bearer /
# static-OIDC consumption, use agent-expertise-api's operator-owned contract:
#   ~/.config/expertise-api/secrets.env (mode 0600)
#   EXPERTISE_API_BASE_URL=https://...
#   EXPERTISE_API_TOKEN=<offline-minted token>
# Never commit either credential. No arbitrary repo `.env` discovery occurs.

# Loopback origin of the local agent-expertise-api. Must be loopback
# (localhost / 127.0.0.0/8 / ::1); non-loopback URLs are refused in phase 1.
PI_EXPERTISE_API_BASE_URL=http://127.0.0.1:8080

# Required for ALL calls. Never commit a real key.
PI_EXPERTISE_API_KEY=replace-me

# Required ONLY for write/create operations (the expertise_create tool, #318).
# Read/search calls ignore this value. Set to 1 to enable local writes.
PI_EXPERTISE_ALLOW_LOCALDEV_WRITE=0
